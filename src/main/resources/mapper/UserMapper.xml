<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.wuzt.myblog.dao.UserDao" >
    <resultMap id="userResult" type="com.wuzt.myblog.model.User" >
        <id column="id" property="id"/>
        <result column="username" property="username"/>
        <result column="password" property="password"/>
        <result column="email" property="email"/>
        <result column="qq" property="qq"/>
        <result column="mobile" property="mobile"/>
        <result column="nickname" property="nickname"/>
        <result column="avatar" property="avatar"/>
        <result column="description" property="description"/>
        <result column="create_time" property="createTime"/>
    </resultMap>
    <sql id="BASE_TABLE">
      user
    </sql>

    <sql id="BASE_COLUMN">
      id,username,password,email,qq,mobile,nickname,avatar,description,create_time
    </sql>


    <!--<insert id="insert" parameterType="com.wuzt.myblog.model.User">
        INSERT INTO
        <include refid="BASE_TABLE"/>
        <trim prefix="(" suffix=")" suffixOverrides=",">
            userName,password,
            <if test="phone != null">
                phone,
            </if>
        </trim>
        <trim prefix="VALUES(" suffix=")" suffixOverrides=",">
            #{userName, jdbcType=VARCHAR},#{password, jdbcType=VARCHAR},
            <if test="phone != null">
                #{phone, jdbcType=VARCHAR},
            </if>
        </trim>
    </insert>-->
    <!--获取所有user-->
    <select id="selectUsers" resultMap="userResult">
        SELECT
          <include refid="BASE_COLUMN"/>
        FROM
          <include refid="BASE_TABLE"/>
    </select>

    <!--根据username获取user-->
    <select id="selectUsersByUserName" resultMap="userResult" parameterType="com.wuzt.myblog.model.User">
        SELECT
        <include refid="BASE_COLUMN"/>
        FROM user
        WHERE username = #{username}
    </select>

    <!-- 根据id获取用户 -->
    <select id="selectUsersById" resultMap="userResult" parameterType="java.lang.Integer">
        SELECT
        <include refid="BASE_COLUMN"/>
        FROM user
        WHERE id = #{id}
    </select>
</mapper>